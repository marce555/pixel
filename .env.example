# Configuration Pixel
PIXEL_AUTO_PUBLISH=false
PIXEL_PUBLISH_URL=https://appliyou.fr/auth/login
PIXEL_PUBLISH_USER=admin
PIXEL_PUBLISH_PASS=
PIXEL_PUBLISH_CREATE_URL=https://appliyou.fr/admin/articles/

# Clés optionnelles
# GOOGLE_API_KEY=
# GOOGLE_CX=

# Agent Vérificateur indépendant (fact-checking des articles avant publication)
# PIXEL_FACTCHECK=on                 # on|off
# PIXEL_FACTCHECK_MODEL=cloud        # cloud (modèle distinct du rédacteur, recommandé) | local
# PIXEL_FACTCHECK_REJECT_RATIO=0.4   # part d'affirmations fausses au-delà de laquelle l'article est bloqué
# PIXEL_FACTCHECK_MAX_CLAIMS=20
# PIXEL_FACTCHECK_REQUIRED=on        # bloquer la publication si la vérification n'a pas pu aboutir
# PIXEL_APPLIYOU_AI_ENHANCE=off      # bouton "Améliorer avec l'IA" du site (réécrit le texte vérifié)
